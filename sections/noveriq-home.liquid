<main class="noveriq-home">

    <section class="hero" id="top">
        <img
                class="hero-bg"
                src="https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=2200&q=85"
                alt=""
                aria-hidden="true"
        >

        <div class="hero-bg-overlay"></div>

        <div class="hero-content">
            <h1>
                Noveriq Virtual Assistant Certification
            </h1>

            <p class="hero-copy">
                NVAC is a beginner-level certification designed for aspiring virtual assistants,
                providing the essential foundation needed to start a career in virtual assistance.
            </p>

            <div class="hero-actions">
                <a class="btn btn-primary" href="{{ routes.root_url }}products/noveriq-virtual-assistant-certification">
                    Explore NVAC
                </a>
            </div>
        </div>
    </section>

    <div class="trust">
        <div class="container trust-inner">
            <span>Professional development</span>
            <span class="trust-dot"></span>
            <span>Virtual assistant focused</span>
            <span class="trust-dot"></span>
            <span>Built for a global audience</span>
        </div>
    </div>

    <section class="section cert-section" id="certification">
        <div class="container">

            <div class="section-head">
                <div class="section-label">The certification</div>

                <h2>First Step Into Virtual Assistance</h2>

                <p>
                    Start with NVAC — A simple foundation for your virtual assistant career
                </p>
            </div>

            <div class="cert-grid">

                <article class="cert-card cert-card-main">

                    <div>
                        <div class="cert-top">

                            <div class="cert-badge">
                                NVAC
                            </div>

                            <div class="status">
                                Available
                            </div>

                        </div>

                        <h3>
                            Noveriq Virtual Assistant Certification
                        </h3>

                        <p>
                            You don't need to know everything. You need to know the essentials.
                        </p>

                        <div class="cert-meta">

            <span class="pill">
              English Communication
            </span>

                            <span class="pill">
              Computer Basics
            </span>

                            <span class="pill">
              Calendar Management
            </span>

                            <span class="pill">
              Microsoft Office Basics
            </span>

                        </div>
                    </div>

                    <div style="margin-top:34px;">
                        <a href="{{ routes.root_url }}products/noveriq-virtual-assistant-certification"
                           class="btn btn-primary">
                            Learn more and get NVAC
                        </a>
                    </div>

                </article>


                <aside class="cert-card cert-side">

                    <div>

                        <div class="section-label">
                            WHY NVAC?
                        </div>

                        <h3>
                            The foundation for your virtual assistant career
                        </h3>

                        <p>
                            NVAC is a simple, beginner-friendly certification designed for people
                            who want to become virtual assistants and prove the essential skills
                            to get started.
                        </p>

                    </div>

                </aside>

            </div>

        </div>
    </section>

    <section class="section exam-section" id="exam">
        <div class="container">

            <div class="section-head">
                <div class="section-label">The exam</div>

                <h2>
                    A simple virtual interview to earn your NVAC.
                </h2>

                <p>
                    After you pay for the exam, you'll be connected with an examiner.
                    Once you agree on a suitable time, your assessment will take place
                    through a virtual interview.
                </p>
            </div>


            <div class="exam-layout">

                <div class="exam-intro">

                    <div class="section-label">
                        How it works
                    </div>

                    <h3>
                        Personal, simple, and fully online.
                    </h3>

                    <p>
                        There is no complicated testing platform. Your NVAC assessment is a
                        scheduled virtual interview with an examiner who will evaluate your
                        essential skills for starting as a virtual assistant.
                    </p>

                    <div class="exam-badge">
                        <span class="exam-badge-dot"></span>
                        Virtual interview
                    </div>

                </div>


                <div class="exam-flow">

                    <article class="exam-step">

                        <div class="exam-step-number">
                            01
                        </div>

                        <div>
                            <h4>
                                Pay for your exam
                            </h4>

                            <p>
                                Complete the payment for the NVAC certification exam.
                            </p>
                        </div>

                    </article>


                    <article class="exam-step">

                        <div class="exam-step-number">
                            02
                        </div>

                        <div>
                            <h4>
                                Connect with your examiner
                            </h4>

                            <p>
                                After payment, you'll be put in contact with the person who will
                                conduct your assessment.
                            </p>
                        </div>

                    </article>


                    <article class="exam-step">

                        <div class="exam-step-number">
                            03
                        </div>

                        <div>
                            <h4>
                                Choose a suitable time
                            </h4>

                            <p>
                                Coordinate directly with your examiner and arrange a time that
                                works for both of you.
                            </p>
                        </div>

                    </article>


                    <article class="exam-step">

                        <div class="exam-step-number">
                            04
                        </div>

                        <div>
                            <h4>
                                Complete your virtual interview
                            </h4>

                            <p>
                                Meet your examiner online and demonstrate the essential skills
                                covered by NVAC.
                            </p>
                        </div>

                    </article>

                </div>

            </div>


            <div class="requirements">

                <div class="requirements-head">

                    <div>

                        <div class="section-label">
                            What you should know
                        </div>

                        <h3>
                            Essential skills for the assessment.
                        </h3>

                    </div>

                    <p>
                        NVAC is designed as a foundation-level certification, so the focus is
                        on practical basics rather than advanced technical expertise.
                    </p>

                </div>


                <div class="requirement-grid">

                    <article class="requirement-card">

                        <div class="requirement-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round"
                                 stroke-linejoin="round" aria-hidden="true">
                                <path d="M4 5h16v11H4z"/>
                                <path d="M8 20h8M12 16v4"/>
                                <path d="M8 9h8M8 12h5"/>
                            </svg>
                        </div>

                        <h4>
                            English Communication
                        </h4>

                        <p>
                            Good conversational English and the ability to communicate clearly.
                        </p>

                    </article>


                    <article class="requirement-card">

                        <div class="requirement-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round"
                                 stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="4" width="18" height="14" rx="2"/>
                                <path d="M8 21h8M12 18v3"/>
                                <path d="M7 8h3M7 11h6M15 8h2M15 11h2"/>
                            </svg>
                        </div>

                        <h4>
                            Computer Basics
                        </h4>

                        <p>
                            General computer knowledge and confidence with everyday digital
                            tasks.
                        </p>

                    </article>


                    <article class="requirement-card">

                        <div class="requirement-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round"
                                 stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="4" width="18" height="17" rx="2"/>
                                <path d="M7 2v4M17 2v4M3 9h18"/>
                                <path d="M8 13h3M13 13h3M8 17h3"/>
                            </svg>
                        </div>

                        <h4>
                            Google Calendar
                        </h4>

                        <p>
                            General knowledge of creating, managing, and organizing calendar
                            events.
                        </p>

                    </article>


                    <article class="requirement-card">

                        <div class="requirement-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round"
                                 stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="3" width="18" height="18" rx="3"/>
                                <path d="M7 7h10v10H7z"/>
                                <path d="M10 7v10M14 7v10M7 10h10M7 14h10"/>
                            </svg>
                        </div>

                        <h4>
                            Microsoft Office
                        </h4>

                        <p>
                            General familiarity with Microsoft tools such as Word and Excel.
                        </p>

                    </article>

                </div>

            </div>

        </div>
    </section>

    <section class="section future-section" id="certifications">
        <div class="container">

            <div class="section-head">
                <div class="section-label">What's next</div>

                <h2>
                    More certifications are coming.
                </h2>

                <p>
                    NVAC is just the beginning. More certifications will be introduced
                    as Noveriq grows.
                </p>
            </div>

            <div class="future-box">

                <div class="future-cards">

                    <article class="future-card future-card-active">
                        <div class="future-number">01</div>
                        <h3>NVAC</h3>
                        <span>Available now</span>
                    </article>

                    <article class="future-card">
                        <div class="future-number">02</div>
                        <h3>NVAC 2</h3>
                        <span>Coming later</span>
                    </article>

                    <article class="future-card">
                        <div class="future-number">03</div>
                        <h3>NVAC 3</h3>
                        <span>Coming later</span>
                    </article>

                    <article class="future-card">
                        <div class="future-number">+</div>
                        <h3>More</h3>
                        <span>Coming later</span>
                    </article>

                </div>

            </div>

        </div>
    </section>
    <section class="cta-section">
        <div class="container">

            <div class="cta">

                <h2>
                    Ready to build your professional edge?
                </h2>

                <p>
                    Explore the NVAC certification and take the next step toward a stronger
                    professional presence as a virtual assistant.
                </p>

                <a class="btn btn-primary" href="{{ routes.root_url }}products/noveriq-virtual-assistant-certification">
                    Explore NVAC
                </a>

            </div>

        </div>
    </section>

</main>

{% schema %}
{
  "name": "Noveriq Home",
  "settings": []
}
{% endschema %}
